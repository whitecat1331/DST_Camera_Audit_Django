# Copy to .env and fill in values (never commit .env).

# Django (required — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Role: capture (laptop, default) = captures in local SQLite, DB_* used only to
# publish finished runs; review (Linode) = DB_* is the only database.
DST_ROLE=capture

# Database — shared Supabase Postgres (the review DB; capture role publishes to it).
# Same setup as IMS: Supabase dashboard -> Connect -> Transaction pooler.
#   DB_HOST     aws-1-ca-central-1.pooler.supabase.com (copy from the dashboard)
#   DB_PORT     6543 = transaction pooler (app); 5432 = session pooler (migrate / loaddata)
#   DB_USER     postgres.<project-ref>
# CA cert: Database Settings -> SSL Configuration -> Download certificate,
# saved as certs/supabase_ca.crt (relative paths resolve from the repo root).
# In Docker, DB_USER / DB_PASSWORD / DJANGO_SECRET_KEY / IMS_API_TOKEN /
# IMS_SSO_CLIENT_SECRET may come from /run/secrets/<lowercase_name> instead.
DB_HOST=
DB_PORT=6543
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=verify-full
DB_SSLROOTCERT=certs/supabase_ca.crt
# Seconds per address before giving up (the camera VPN blocks 5432/6543).
DB_CONNECT_TIMEOUT=10

# IMS integration (SSO + inventory API)
IMS_BASE_URL=
IMS_SSO_CLIENT_ID=
IMS_SSO_CLIENT_SECRET=
# Optional for local dev: `runserver --ims <url> --http/--https <port>` derives
# this from the chosen scheme/port. Set it explicitly only when the callback
# host differs from where the dev server binds.
IMS_SSO_REDIRECT_URI=
IMS_API_TOKEN=
IMS_TLS_VERIFY=true

# Post-Install export — optional Site Documents root override.
# Auto-detects mapped drives and SharePoint sync paths such as:
#   %USERPROFILE%\Blue Line Solutions, LLC\PSCU Production - Documents\Site Documents
# DE_PI_SITE_DOCUMENTS_ROOT=C:\Users\you\Blue Line Solutions, LLC\PSCU Production - Documents\Site Documents

# Break-glass local Django admin (optional)
DST_LOCAL_ADMIN=false

# LTI pole captures (CBW + VNC)
TF_VNC_PASSWORD=
CBW_USERNAME=
CBW_PASSWORDS=

# DragonEye / TeamViewer captures
# TV_PASSWORD: comma-separated. Connection tries each until a session opens;
# in-session OS/DragonCam login always uses the *last* entry.
# Example: TV_PASSWORD='tvConnAlt,cameraLoginPw'
TV_USERNAME=
TV_PASSWORD=
# Optional override for connection-only passwords (defaults to TV_PASSWORD list)
TEAMVIEWER_PASSWORDS=
TEAMVIEWER_PATH=

# OvrC — local date/time from each FX customer dashboard (Selenium)
# Login at app.ovrc.com, search FX####, open dashboard, scrape Location Information.
OVRC_USERNAME=
OVRC_PASSWORD=
# Optional; default https://app.ovrc.com
OVRC_BASE_URL=

# VBE Daily Checks — shared OneDrive folder for AM/PM lane PNGs
# Creates {year}/{MM Month YYYY}/VBE NNNN/{M.D.YY} {AM|PM} Check Lane N.png
VBE_DAILY_CHECKS_ROOT=

# Audit concurrency
AUDIT_MAX_CONCURRENT=2
AUDIT_STEP_CONCURRENT=3
# Max seconds a queued job waits for a free worker (stuck TV holds the slot).
AUDIT_SLOT_WAIT_SECONDS=300
# Seconds to wait after DST Audit power-on before captures (camera boot).
DST_POWER_SETTLE_SECONDS=90
# Unattended runs on a pre-connected camera VPN: LTI first, then DST disconnects
# the VPN for DE + publish (it never connects it). Off = today's order.
DST_NETWORK_PHASES=false
# DST_VPN_MGMT_PORT=1337
# DST_PUBLISH_WAIT_SECONDS=43200

# Logging
LOG_LEVEL=info
LOG_FILE=logs/dst.log
LOG_TO_FILE=true
